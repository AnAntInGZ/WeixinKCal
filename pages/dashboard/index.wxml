<view class="screen">
  <view class="statusbar">
    <text>9:41</text>
    <text>● ● ●　🔋</text>
  </view>
  <view class="pad" style="padding-top:6px">
    <view style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
      <view>
        <view class="sub">早上好呀 ☀️</view>
        <view class="h1">今天吃得不错！</view>
      </view>
      <view class="avatar-bubble">😋</view>
    </view>
    <view class="hero">
      <view class="hero-fire">🔥</view>
      <view class="lab">还可以吃 🍽️</view>
      <view class="big">{{summary.remainingCalories}}</view>
      <view class="small">已摄入 {{summary.totalCalories}} / 目标 {{summary.targetCalories}} kcal</view>
      <view class="pbar">
        <view class="fill" style="width:{{summary.progressPercent}}%"></view>
      </view>
    </view>
    <view class="chips">
      <view class="chip">
        <view class="e">🍞</view>
        <view class="v">{{summary.totalCarbsG}}g</view>
        <view class="k">碳水</view>
      </view>
      <view class="chip">
        <view class="e">🥩</view>
        <view class="v">{{summary.totalProteinG}}g</view>
        <view class="k">蛋白</view>
      </view>
      <view class="chip">
        <view class="e">🥑</view>
        <view class="v">{{summary.totalFatG}}g</view>
        <view class="k">脂肪</view>
      </view>
    </view>
    <view class="sec">今日餐食 🍱</view>
    <view class="meal" wx:for="{{meals}}" wx:key="id">
      <view class="ic" style="background:{{item.color}}">{{item.icon}}</view>
      <view class="info">
        <view class="t">{{item.title}}</view>
        <view class="d">{{item.detail}}</view>
      </view>
      <view class="kc">{{item.calories}}</view>
    </view>
    <view class="meal empty-meal" wx:if="{{!meals.length}}">
      <view class="ic" style="background:#fff0e6">＋</view>
      <view class="info">
        <view class="t">还没有记录</view>
        <view class="d">点下面的 + 记录第一餐</view>
      </view>
      <view class="kc">0</view>
    </view>
    <view style="height:100px"></view>
  </view>
  <view class="tabbar">
    <view class="tab on">
      <text class="i">🏠</text>
      <text>首页</text>
    </view>
    <view class="tab">
      <text class="i">📊</text>
      <text>统计</text>
    </view>
    <view class="fab" bindtap="goUpload">+</view>
    <view class="tab">
      <text class="i">🥗</text>
      <text>食谱</text>
    </view>
    <view class="tab">
      <text class="i">😺</text>
      <text>我的</text>
    </view>
  </view>
</view>
