<view class="screen upload-screen">
  <view class="statusbar">
    <text>9:41</text>
    <text>● ● ●　🔋</text>
  </view>
  <view class="upload-layout">
    <view class="upload-head">
      <view>
        <view class="h1">记录{{mealTypeLabels[mealTypeIndex]}} 🍽️</view>
        <view class="sub">拍张照，卡卡帮你算热量~</view>
      </view>
      <view class="form-row upload-form-row">
        <view class="form-field">
          <text class="field-label">日期</text>
          <picker mode="date" value="{{form.dateKey}}" bindchange="handleDateChange">
            <view class="select-box">{{form.dateKey}}</view>
          </picker>
        </view>
        <view class="form-field meal-type-field">
          <text class="field-label">餐次</text>
          <picker mode="selector" range="{{mealTypeLabels}}" value="{{mealTypeIndex}}" bindchange="handleMealTypeChange">
            <view class="select-box">{{mealTypeLabels[mealTypeIndex]}}</view>
          </picker>
        </view>
      </view>
    </view>
    <view class="cam upload-camera">
      <view class="ci">📸</view>
      <view>点我拍食物</view>
    </view>
    <scroll-view class="food-list" scroll-y="true">
      <view class="fi food-card" wx:for="{{form.items}}" wx:key="index">
        <view class="food-top">
          <view class="e">{{item.emoji}}</view>
          <input class="n food-input" value="{{item.name}}" placeholder="食物名称" data-index="{{index}}" data-field="name" bindinput="handleItemInput" />
          <button class="remove-btn" data-index="{{index}}" bindtap="removeFood">×</button>
        </view>
        <view class="food-bottom">
          <view class="food-meta">
            <input class="mini-input" type="number" value="{{item.kcalPer100g}}" data-index="{{index}}" data-field="kcalPer100g" bindinput="handleItemInput" />
            <text class="p">kcal/100g</text>
          </view>
          <view class="qty">
            <button class="qbtn" data-index="{{index}}" data-delta="-10" bindtap="changeAmount">−</button>
            <input class="qv qinput" type="number" value="{{item.amountGram}}" data-index="{{index}}" data-field="amountGram" bindinput="handleItemInput" />
            <text class="gram">g</text>
            <button class="qbtn" data-index="{{index}}" data-delta="10" bindtap="changeAmount">+</button>
          </view>
          <text class="item-total">{{item.calories}} kcal</text>
        </view>
      </view>
    </scroll-view>
    <button class="add-food" bindtap="addFood">+ 添加食物</button>
    <textarea class="note-input" value="{{form.note}}" placeholder="备注，例如少油、去皮、饭后水果" bindinput="handleNoteInput"></textarea>
    <view class="upload-footer">
      <view class="total compact-total">
        <view class="tl">这一餐总共 🔥</view>
        <view class="tv">{{totalCalories}}</view>
      </view>
      <button class="btn compact-save" bindtap="saveMeal">存好啦 ✓</button>
    </view>
  </view>
</view>
