<view class="screen">
  <view class="statusbar" style="color:#fff">
    <text>9:41</text>
    <text>● ● ●　🔋</text>
  </view>
  <view class="onb">
    <view class="mascot">🍊</view>
    <view class="onb-title">嗨，我是卡卡！</view>
    <view class="p">
      <text>告诉我你的小目标，</text>
      <text>我帮你算好每天能吃多少~</text>
    </view>
    <view class="sheet">
      <view class="field">
        <text class="field-label">你的性别</text>
        <view class="pill">
          <text class="pill-item on">男生</text>
          <text class="pill-item">女生</text>
        </view>
      </view>
      <view class="field">
        <text class="field-label">身高 &amp; 体重</text>
        <view class="inp">
          <view class="box">
            <view class="n">178</view>
            <view class="u">身高 cm</view>
          </view>
          <view class="box">
            <view class="n">74</view>
            <view class="u">体重 kg</view>
          </view>
        </view>
      </view>
      <view class="field" style="margin-bottom:0">
        <text class="field-label">想要达成</text>
        <view class="goalpill">
          <text class="goal-item on">减脂</text>
          <text class="goal-item">减重</text>
          <text class="goal-item">增肌</text>
        </view>
      </view>
    </view>
    <button class="btn btn-white" bindtap="startPlan">开启计划 🚀</button>
  </view>
</view>
