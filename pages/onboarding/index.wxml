<view class="screen">
  <view class="statusbar" style="color:#fff">
    <text>9:41</text>
    <text>● ● ●　🔋</text>
  </view>
  <view class="onb">
    <view class="mascot">🍊</view>
    <view class="onb-title">嗨，我是卡卡！</view>
    <view class="p">
      <text>告诉我你的小目标，</text>
      <text>我帮你算好每天能吃多少~</text>
    </view>
    <view class="sheet">
      <view class="field">
        <text class="field-label">你的性别</text>
        <view class="pill">
          <text
            wx:for="{{genderOptions}}"
            wx:key="value"
            class="pill-item {{form.gender === item.value ? 'on' : ''}}"
            data-value="{{item.value}}"
            bindtap="selectGender"
          >{{item.label}}</text>
        </view>
      </view>
      <view class="field">
        <text class="field-label">年龄 · 身高 · 体重</text>
        <view class="inp">
          <view class="box">
            <input class="n num-input" type="number" value="{{form.age}}" data-field="age" bindinput="handleInput" />
            <view class="u">年龄 岁</view>
          </view>
          <view class="box">
            <input class="n num-input" type="number" value="{{form.heightCm}}" data-field="heightCm" bindinput="handleInput" />
            <view class="u">身高 cm</view>
          </view>
          <view class="box">
            <input class="n num-input" type="digit" value="{{form.weightKg}}" data-field="weightKg" bindinput="handleInput" />
            <view class="u">体重 kg</view>
          </view>
        </view>
      </view>
      <view class="field">
        <text class="field-label">日常活动</text>
        <picker mode="selector" range="{{activityLabels}}" value="{{activityIndex}}" bindchange="handleActivityChange">
          <view class="select-box">{{activityLabels[activityIndex]}}</view>
        </picker>
      </view>
      <view class="field" style="margin-bottom:0">
        <text class="field-label">想要达成</text>
        <view class="goalpill">
          <text
            wx:for="{{goalOptions}}"
            wx:key="value"
            class="goal-item {{form.goal === item.value ? 'on' : ''}}"
            data-value="{{item.value}}"
            bindtap="selectGoal"
          >{{item.label}}</text>
        </view>
      </view>
    </view>
    <button class="btn btn-white" bindtap="startPlan">开启计划 🚀</button>
  </view>
</view>
