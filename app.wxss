page {
  min-height: 100%;
  background: #ffe3d0;
  color: #3a2a2a;
  font-family: "Baloo 2", "Quicksand", -apple-system, "PingFang SC", sans-serif;
}

view,
text,
button {
  box-sizing: border-box;
}

button::after {
  border: none;
}

.screen {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  background: #fff6ee;
}

.statusbar {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24px;
  font-size: 13px;
  font-weight: 700;
}

.pad {
  padding: 0 22px;
}

.h1 {
  font-size: 28px;
  font-weight: 800;
  letter-spacing: -.5px;
  line-height: 1.2;
}

.sub {
  color: #a89090;
  font-size: 14px;
  margin-top: 4px;
  font-weight: 600;
}

.avatar-bubble {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff8a3d, #ff5c7c);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
}

.card {
  background: #ffffff;
  border-radius: 28px;
  padding: 20px;
  box-shadow: 0 10px 26px rgba(255, 140, 90, .14);
}

.btn {
  background: linear-gradient(135deg, #ff8a3d, #ff5c7c);
  color: #fff;
  border: none;
  border-radius: 22px;
  padding: 18px;
  width: 100%;
  margin-left: 0;
  margin-right: 0;
  font-size: 17px;
  font-weight: 800;
  line-height: 1;
  box-shadow: 0 12px 24px rgba(255, 92, 124, .4);
}

.btn-white {
  margin-top: 18px;
  background: #fff;
  color: #ff5c7c;
}

.onb {
  min-height: calc(100vh - 44px);
  background: linear-gradient(160deg, #ff8a3d 0%, #ff5c7c 100%);
  padding: 56px 26px 26px;
  display: flex;
  flex-direction: column;
  color: #fff;
}

.mascot {
  width: 120px;
  height: 120px;
  border-radius: 40px;
  background: rgba(255, 255, 255, .22);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64px;
  margin: 0 auto 8px;
  box-shadow: 0 12px 30px rgba(0, 0, 0, .12);
}

.onb .onb-title {
  font-size: 34px;
  font-weight: 800;
  text-align: center;
  letter-spacing: -.5px;
}

.onb .p {
  text-align: center;
  opacity: .95;
  margin-top: 8px;
  font-size: 15px;
  font-weight: 600;
  line-height: 1.5;
}

.onb .p text {
  display: block;
}

.sheet {
  background: #fff;
  border-radius: 32px;
  padding: 22px;
  margin-top: 24px;
  color: #3a2a2a;
  box-shadow: 0 -6px 30px rgba(0, 0, 0, .1);
}

.field {
  margin-bottom: 16px;
}

.field-label {
  font-size: 13px;
  font-weight: 700;
  color: #3a2a2a;
  margin-bottom: 8px;
  display: block;
}

.pill {
  display: flex;
  gap: 10px;
}

.pill-item {
  flex: 1;
  text-align: center;
  padding: 13px;
  border-radius: 18px;
  background: #fff0e6;
  font-size: 14px;
  font-weight: 700;
  color: #c0603a;
}

.pill-item.on {
  background: linear-gradient(135deg, #ff8a3d, #ff5c7c);
  color: #fff;
}

.inp {
  display: flex;
  gap: 12px;
}

.inp .box {
  flex: 1;
  background: #fff0e6;
  border-radius: 18px;
  padding: 14px 16px;
}

.inp .box .n {
  font-size: 24px;
  font-weight: 800;
}

.inp .box .u {
  font-size: 11px;
  color: #a89090;
  font-weight: 600;
}

.goalpill {
  display: flex;
  gap: 8px;
}

.goalpill .goal-item {
  flex: 1;
  text-align: center;
  padding: 15px 4px;
  border-radius: 18px;
  background: #fff0e6;
  font-size: 13px;
  font-weight: 700;
  color: #c0603a;
}

.goalpill .goal-item.on {
  background: #6a5cff;
  color: #fff;
  box-shadow: 0 8px 18px rgba(106, 92, 255, .4);
}

.hero {
  background: linear-gradient(135deg, #ff8a3d, #ff5c7c);
  border-radius: 32px;
  padding: 24px;
  color: #fff;
  position: relative;
  overflow: hidden;
}

.hero-fire {
  position: absolute;
  right: -10px;
  top: -10px;
  font-size: 120px;
  opacity: .18;
}

.hero .lab {
  font-size: 14px;
  font-weight: 700;
  opacity: .95;
}

.hero .big {
  font-size: 54px;
  font-weight: 800;
  line-height: 1;
  margin: 6px 0;
}

.hero .small {
  font-size: 13px;
  opacity: .9;
  font-weight: 600;
}

.hero .pbar {
  height: 10px;
  border-radius: 10px;
  background: rgba(255, 255, 255, .3);
  margin-top: 16px;
  overflow: hidden;
}

.hero .pbar .fill {
  display: block;
  height: 100%;
  border-radius: 10px;
  background: #fff;
}

.chips {
  display: flex;
  gap: 12px;
  margin-top: 16px;
}

.chip {
  flex: 1;
  background: #fff;
  border-radius: 22px;
  padding: 16px;
  text-align: center;
  box-shadow: 0 8px 20px rgba(255, 140, 90, .12);
}

.chip .e {
  font-size: 24px;
}

.chip .v {
  font-size: 20px;
  font-weight: 800;
  margin-top: 4px;
}

.chip .k {
  font-size: 11px;
  color: #a89090;
  font-weight: 600;
}

.sec {
  font-size: 18px;
  font-weight: 800;
  margin: 24px 0 12px;
}

.meal {
  display: flex;
  align-items: center;
  gap: 14px;
  background: #fff;
  border-radius: 24px;
  padding: 14px;
  margin-bottom: 12px;
  box-shadow: 0 8px 20px rgba(255, 140, 90, .1);
}

.meal .ic {
  width: 54px;
  height: 54px;
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26px;
}

.meal .info {
  flex: 1;
}

.meal .info .t {
  font-weight: 800;
  font-size: 16px;
}

.meal .info .d {
  font-size: 12px;
  color: #a89090;
  font-weight: 600;
  margin-top: 2px;
}

.meal .kc {
  font-weight: 800;
  font-size: 18px;
  color: #ff5c7c;
}

.tabbar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80px;
  background: #fff;
  border-radius: 30px 30px 0 0;
  box-shadow: 0 -6px 24px rgba(255, 140, 90, .16);
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-bottom: 14px;
}

.tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  font-size: 10px;
  color: #a89090;
  font-weight: 700;
}

.tab.on {
  color: #ff5c7c;
}

.tab .i {
  font-size: 22px;
}

.fab {
  width: 60px;
  height: 60px;
  border-radius: 24px;
  background: linear-gradient(135deg, #ff8a3d, #ff5c7c);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32px;
  margin-top: -28px;
  box-shadow: 0 10px 24px rgba(255, 92, 124, .5);
}

.cam {
  height: 175px;
  border-radius: 28px;
  background: linear-gradient(135deg, #ffd9c2, #ffc2cf);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin: 16px 0;
  color: #c0603a;
  font-weight: 700;
}

.cam .ci {
  font-size: 46px;
}

.fi {
  display: flex;
  align-items: center;
  gap: 12px;
  background: #fff;
  border-radius: 22px;
  padding: 14px;
  margin-bottom: 12px;
  box-shadow: 0 6px 16px rgba(255, 140, 90, .1);
}

.fi .e {
  width: 48px;
  height: 48px;
  border-radius: 16px;
  background: #fff0e6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
}

.fi .info {
  flex: 1;
}

.fi .info .n {
  font-weight: 800;
  font-size: 15px;
}

.fi .info .p {
  font-size: 12px;
  color: #a89090;
  font-weight: 600;
}

.qty {
  display: flex;
  align-items: center;
  gap: 8px;
}

.qty .qbtn {
  width: 30px;
  height: 30px;
  border-radius: 11px;
  border: none;
  background: linear-gradient(135deg, #ff8a3d, #ff5c7c);
  color: #fff;
  font-size: 18px;
  font-weight: 800;
  line-height: 30px;
  padding: 0;
  margin-left: 0;
  margin-right: 0;
}

.qty .qv {
  font-size: 14px;
  font-weight: 700;
  min-width: 42px;
  text-align: center;
}

.total {
  background: linear-gradient(135deg, #ffb347, #ff8a3d);
  border-radius: 26px;
  padding: 20px;
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 8px 0 16px;
  box-shadow: 0 10px 24px rgba(255, 140, 90, .35);
}

.total .tl {
  font-size: 14px;
  font-weight: 700;
  opacity: .95;
}

.total .tv {
  font-size: 38px;
  font-weight: 800;
}
